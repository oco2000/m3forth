\
\ ARMv7-M Thumb2 Assembler
\

BASE @ HEX

VOCABULARY ASSEMBLER
ALSO ASSEMBLER DEFINITIONS

: NOOP ;

\ Enumerations
: ENUMERATE:  ( N start "name1" ... "nameN" -- )
   DUP ROT + SWAP ?DO   I CONSTANT  LOOP ;

: NAND ( x1 -- x2 )  INVERT AND ;
: ?REGISTER   ( r -- )
   0 10 WITHIN INVERT ABORT" Inavlid operand, need a register R0..R15" ;
: ?LOW-REGISTER ( r -- r )
    DUP 0 8 WITHIN INVERT ABORT" Inavlid operand, need a register R0..R7" ;
: E_PSR ( f -- )
    ABORT" Invalid operand, need special register" ;
: ?PSR   ( r -- ) \ test for program status registers
    DUP 4 = E_PSR
    DUP A 10 WITHIN E_PSR
    15 80 WITHIN E_PSR
;

\ Register stack
VARIABLE RSP
5 CONSTANT #RMAX \ items in the stack

#RMAX CELLS CONSTANT RSLEN \ stack len in bytes
RSLEN ALLOT
HERE CONSTANT RS0 \ stack bottom
: REMPTY ( -- ) \ clear the stack
    RS0 RSP !
    RS0 RSLEN - RSLEN ERASE  ;
: RDEPTH ( -- n )
    RS0 RSP @ - CELL / ;
: RPUSH ( r -- )
    RDEPTH #RMAX = ABORT" Too many register operands"
    RSP @ CELL - DUP RSP ! ! ;
: RPOP ( r -- )
    RSP @ DUP CELL + DUP RS0 > ABORT" Register stack underflow" RSP ! @ ;

: RSWAP ( -- )
    RPOP RPOP SWAP RPUSH RPUSH ;

: Nth ( n -- r ) \ take nth item from the register stack
    CELLS RSP @ + @ ;

: NthREG: \ create a register abbreviation
    CREATE ,
    DOES>  ( -- reg ) @ Nth ;

\ register abbreviations
0 NthREG: Rd
1 NthREG: Rn
2 NthREG: Rm
3 NthREG: Rt

\ Processor registers

VARIABLE IN_REGLIST \ we are in a register list now, e.g. { r0 r1 r2 r13 }
FALSE IN_REGLIST !

: REG: ( number )
    CREATE ,
    DOES>
        \ a register pushes its number onto the register stack when used
        \ when in a reglist - register number is left on the data stack
        @ IN_REGLIST @ INVERT IF RPUSH THEN
;

\ create the registers
: REGS:  10 0 DO  I REG: LOOP ;
REGS: r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15

\ register aliases
0D REG: sp
0E REG: lr
0F REG: pc
06 REG: tos  \ top of stack
07 REG: fsp  \ data stack pointer
00 REG: tmp  \ temp register
01 REG: tmp1 \ temp register
02 REG: tmp2 \ temp register
03 REG: tmp3 \ temp register
04 REG: tmp4 \ temp register
08 REG: rambase \ ram base address

\ Bit masks

\ create a bitmask of one bit n
: BIT:  ( n "name" -- )   BIT CONSTANT ;

\ form a bitmask from bit numbers on the stack, 0 is the limiter
: BITS ( 0 bit1 ... bitN -- x )
   0  BEGIN OVER OR  SWAP 0= UNTIL ;

\ instruction bitmasks
18 BIT: %P      A BIT: %P2
17 BIT: %U      9 BIT: %U2
15 BIT: %W      8 BIT: %W2
14 BIT: %S

\ Basic instruction creation, condition codes
8 CONSTANT #VARIANTS   \ maximum number of variants of an instruction

VARIABLE INSTRUCTION \ current opcode
VARIABLE IMM \ immediate data flag
VARIABLE SHIFT \ shift value
VARIABLE SHIFT_TYPE \ shift type
VARIABLE WIDTH \ bit field width for bfc, bfi, sbfx, ubfx
VARIABLE REGLIST \ current reglist bitmask
VARIABLE WRITEBACK \ writeback flag
VARIABLE ADDRESSING_MODE \ addressing mode
VARIABLE CCODE \ current condition code
VARIABLE ITBLOCK    \ 0 if not in it_block, otherwise it is the instruction number in it block
0 ITBLOCK !

0 VALUE FAILED? \ current instruction variant is impossible, coding failed
0 VALUE NARROW? \ is opcode narrow

: in_it_block? ( -- f ) \ we are in it block
    ITBLOCK @ 0> ;
: last_or_not_in_it_block? ( -- f ) \ last instruction in it block or not in it block
    ITBLOCK @ 2 < ;

: ?in_it_block
    in_it_block? ABORT" Can not be inside IT block" ;

\ condition codes
: CC:  ( x "name" -- )  CREATE ,
  DOES> @  ( -- mask )
   \ set the current condition code
   CCODE ! ;

00 CC: eq   01 CC: ne
02 CC: cs   03 CC: cc
04 CC: mi   05 CC: pl
06 CC: vs   07 CC: vc
08 CC: hi   09 CC: ls
0A CC: ge   0B CC: lt
0C CC: gt   0D CC: le
0E CC: al   0F CC: nv
02 CC: hs   03 CC: lo

: ?al   ( -- f ) \ al confition code?
    CCODE @ 0E = ;

\ instruction variants
: NEW_VARIANT ( -- ) \ initialize a variant
    0 INSTRUCTION !
    FALSE TO FAILED?
;

0x77777778 CONSTANT NOCONST \ marker of 'not a constant'

: NEW ( -- ) \ start a new instruction
    REMPTY
    NOCONST IMM !
    NOCONST WIDTH !
    NOCONST SHIFT !
    NOCONST REGLIST !
    0 SHIFT_TYPE !
    FALSE WRITEBACK !
    0 ADDRESSING_MODE !
    al
;

: NARROW ( -- ) \ start a narrow variant description
    TRUE TO NARROW? NEW_VARIANT ;
: WIDE ( -- ) \ start a wide variant description
    FALSE TO NARROW? NEW_VARIANT ;
: FAILED ( -- ) \ set to failure
    TRUE TO FAILED? ;
: ?FAILED!   ( f -- ) \ if true - exit one level, set failure
    IF FAILED RDROP THEN ;
: ?1FAILED!   ( f -- ) \ if true - exit one level, set failure and drop one item from the data stack
    IF FAILED RDROP DROP THEN ;

\ encode the bitmask into the current opcode by ORing
: ENCODE  ( x1 -- )   INSTRUCTION @  OR  INSTRUCTION ! ;

\ create a word for the register descriptor (Rd, Rn, Rm, Rt) which will encode a register into its place
\ they have permanent places in the opcode, depending on whether it is wide or narrow
\ so the narrow_shift is the number of LSHIFTs for the place in the narrow opcode and wide_shift - for the wide opcode

: Reg!  ( narrow_shift wide_shift -- )
    CREATE 2,
    DOES> ( n -- ) \ store register number n in place of a register descriptor
        2@
        NARROW? IF DROP ELSE NIP THEN
        LSHIFT ENCODE ;

0  8 Reg! Rd!
3 10 Reg! Rn!
6  0 Reg! Rm!
0  C Reg! Rt!

\ special cases for registers in the opcode
: Rd2! ( reg -- )
    DUP 7 AND ENCODE
    8 AND 4 LSHIFT ENCODE ;

: Rn2! ( reg -- )
    3 LSHIFT ENCODE ;

: Rt2! ( reg -- )
    8 LSHIFT ENCODE ;

: RdLo8! ( reg -- )
    8 LSHIFT ENCODE ;

\ checkers - they ensure that some conditions are met for the instruction variant to be valid

\ low register checkers
: RLo?  ( reg -- f ) \ is this register a low register (0..7)?
    0 8 WITHIN ;

\ create a checker for a low register
: RegLo:    ( "reg" "reg!" )
    CREATE ' , ' ,
    DOES> 2@
        \ if a register is not low - fail, otherwise encode it into specified place
        EXECUTE DUP RLo? IF SWAP EXECUTE ELSE 2DROP FAILED THEN ;

RegLo:  ?RdLo   Rd Rd!          \ Rd should be low
RegLo:  ?RdLo8  Rd RdLo8!       \ Rd should be low (8 bits only)
RegLo:  ?RnLo   Rn Rn!          \ Rn should be low
RegLo:  ?RmLo   Rm Rm!          \ Rm should be low

\ register checkers
: ?Rd       Rd Rd! ;            \ Rd should be set
: ?Rn       Rn Rn! ;            \ Rn should be set
: ?Rm       Rm Rm! ;            \ Rm should be set
: ?Rt       Rt Rt! ;            \ Rt should be set

                                \ some opcodes have places for registers other that default ones
: ?RnRm     Rn Rn! Rn Rm! ;     \ Rn should be set, encode it both to Rn and Rm
: ?Rd>Rn    Rd Rn! ;            \ Rd should be set, encode it to Rn place
: ?Rd>Rm    Rd Rm! ;            \ Rd should be set, encode it to Rm place
: ?Rd>Rt    Rd Rt! ;            \ Rd should be set, encode it to Rt place
: ?Rd>Rt2   Rn Rt2! ;           \ Rd should be set, encode it to Rt2 place
: ?Rn>Rm    Rn Rm! ;            \ Rn should be set, encode it to Rm place
: ?Rn>Rd    Rn Rd! ;            \ Rn should be set, encode it to Rd place
: ?Rn>Rt    Rn Rt! ;            \ Rn should be set, encode it to Rt place
: ?Rm>Rn    Rm Rn! ;            \ Rm should be set, encode it to Rn place
: ?Rm>Rt    Rm Rt! ;            \ Rm should be set, encode it to Rt place
: ?Rt>Rm    Rt Rm! ;            \ Rt should be set, encode it to Rm place
: ?Rn>Rt2   Rn Rt2! ;           \ Rn should be set, encode it to Rt2 place
: ?Rd>Rd2   Rd Rd2! ;           \ Rd should be set, encode it to Rt2 place
: ?Rn>Rn2   Rn Rn2! ;           \ Rn should be set, encode it to Rn2 place
: ?Rd>Rn2   Rd Rn2! ;           \ Rd should be set, encode it to Rn2 place

\ check if n registers were used in the instruction
: ?regs ( n -- )
    RDEPTH <> IF FAILED THEN ;

: ?WIDTH ( n m -- f ) \ if n is in 0..m-1 interval
    0 SWAP WITHIN ;

\ immediate values can be coded in different places of the opcode
: ?imm \ immediate value should be set
    IMM @ NOCONST = IF FAILED THEN ;

\ different methods of encoding immediate values
: i! ( n -- ) \ wide only, 1A shift
    NARROW? IF DROP FAILED ELSE 1A LSHIFT ENCODE THEN ;
: i2shift! ( n -- ) \ wide opcode 2bit immediate value
    NARROW? ?1FAILED!
    DUP 2 BIT ?WIDTH INVERT ?1FAILED!
    4 LSHIFT ENCODE
;
: i3! ( n -- ) \ narrow immediate
    NARROW? IF 6 LSHIFT ENCODE ELSE DROP FAILED THEN ;
: i3const! ( n -- ) \ wide immediate
    NARROW? IF DROP FAILED ELSE 0C LSHIFT ENCODE THEN ;
: i4! ( n -- )
    ENCODE ;
: i5! ( n -- )
    NARROW? IF 6 ELSE 0 THEN LSHIFT ENCODE ;
: i5shift! ( n -- )
    NARROW? IF 6 LSHIFT ELSE
        DUP 3 AND 6 LSHIFT ENCODE
        1C AND A LSHIFT
    THEN  ENCODE ;
: i6! ( n -- )
    NARROW? IF
        DUP 1F AND 3 LSHIFT ENCODE
        20 AND 4 LSHIFT ENCODE
    ELSE DROP FAILED
    THEN ;
: i7! ( n -- )
    ENCODE ;
: i8! ( n -- )
    ENCODE ;
: i12! ( n -- ) \ wide only 12 bit value
    NARROW? IF DROP FAILED ELSE
        DUP 0FF AND ENCODE \ i8
        DUP 0700 AND 4 LSHIFT ENCODE
            0800 AND F LSHIFT ENCODE
    THEN ;
: i16! ( n -- ) \ wide 16 bit value
    NARROW? IF DROP FAILED ELSE
        DUP i12!
        F000 AND 4 LSHIFT ENCODE
    THEN ;

: ?i5*2 ( -- ) \ check and encode 5bit even value
    ?imm
    IMM @ 1 AND ?FAILED!
    IMM @ 1 RSHIFT DUP 5 BIT ?WIDTH IF i5! ELSE DROP FAILED THEN
;

: ?i5*4 ( -- ) \ check and encode 5bit value, last 2 bits should be 0
    ?imm
    IMM @ 3 AND ?FAILED!
    IMM @ 2 RSHIFT DUP 5 BIT ?WIDTH IF i5! ELSE DROP FAILED THEN
;

: ?i7*4 ( -- ) \ check and encode 7bit value, last 2 bits should be 0
    ?imm
    IMM @ 3 AND ?FAILED!
    IMM @ 2 RSHIFT DUP 7 BIT ?WIDTH IF i7! ELSE DROP FAILED THEN
;

: ?i8*4 ( -- ) \ check and encode 8bit value, last 2 bits should be 0
    ?imm
    IMM @ 3 AND ?FAILED!
    IMM @ 2 RSHIFT DUP 8 BIT ?WIDTH IF i8! ELSE DROP FAILED THEN
;

: ?-i8 ( -- ) \ check and encode 8bit negative value
    ?imm
    IMM @ DUP 0> ?1FAILED!
    NEGATE DUP 8 BIT ?WIDTH INVERT ?1FAILED!
    ENCODE
;

\ labels
: offset ( -- offset ) \ calculate offset of immediate value (for labels)
    IMM @ THERE - 4 - ;

: offset_aligned ( -- offset ) \ aligned offset
    IMM @ THERE DUP TALIGNED? INVERT IF TALIGNED 4 - THEN - 4 - ;

: ?-label12 ( -- ) \ check and encode a 12bit negative offset
    ?imm
    offset_aligned DUP 0< IF
        NEGATE DUP 12 BIT ?WIDTH IF i12! ELSE DROP FAILED THEN
    ELSE DROP FAILED THEN ;

: ?+label12 ( -- ) \ check and encode a 12bit positive offset
    ?imm
    offset_aligned DUP 0> IF
        DUP 12 BIT ?WIDTH IF i12! ELSE DROP FAILED THEN
    ELSE DROP FAILED THEN ;

: ?+-label12 ( -- ) \ check and encode a 12bit positive/negative offset
    ?imm
    offset_aligned DUP 0< DUP IF SWAP NEGATE SWAP THEN INVERT ( imm U )
    %U AND ENCODE
    DUP 12 BIT ?WIDTH INVERT ?1FAILED!
    ENCODE
;

: ?+-label8*4 ( -- ) \ check and encode an 8bit offset (last 2 bits are 0)
    ?imm
    offset_aligned DUP 0< DUP IF SWAP NEGATE SWAP THEN INVERT ( imm U )
    %U AND ENCODE
    DUP 3 AND  ?1FAILED!
    DUP 12 BIT ?WIDTH INVERT ?1FAILED!
    2 RSHIFT DUP 8 BIT ?WIDTH INVERT ?1FAILED!
    i8!
;

: ?+label8*4 ( -- ) \ check and encode an 8bit positive offset (last 2 bits are 0)
    ?imm
    offset_aligned  DUP 0< ?1FAILED!
    DUP 3 AND  ?1FAILED!
    2 RSHIFT DUP 8 BIT ?WIDTH INVERT ?1FAILED!
    i8!
;

: ?+label6*2 ( -- ) \ check and encode a 6bit positive offset (last 2 bits are 0)
    ?imm
    offset DUP 0< ?1FAILED!
    1 RSHIFT DUP 6 BIT ?WIDTH INVERT ?1FAILED!
    i6!
;

: ?width ( -- ) \ check and encode bit field width
    ?imm
    WIDTH @ NOCONST = ?FAILED!
    IMM @ 0 20 WITHIN INVERT ?FAILED!
    WIDTH @ 1 IMM @ \ lsb
    21 SWAP - WITHIN INVERT ?FAILED!
    IMM @ WIDTH @ + 1- 1F AND ENCODE
;

: ?widthm1 ( -- ) \ check and encode bit field width - 1
    ?imm
    WIDTH @ NOCONST = ?FAILED!
    IMM @ 0 20 WITHIN INVERT ?FAILED!
    WIDTH @ 1 20 IMM @ - WITHIN INVERT ?FAILED!
    WIDTH @ 1- 1F AND ENCODE
;

\ create immediate value checkers dependent on value width
: Imm:    ( width "ix!" -- )
    CREATE , ' ,
    DOES> 2@ ?imm
        IMM @ DUP ROT BIT ?WIDTH IF SWAP EXECUTE ELSE 2DROP FAILED THEN ;

3  Imm:       ?i3    i3!
4  Imm:       ?i4    i4!
5  Imm:       ?i5    i5!
8  Imm:       ?i8    i8!
C  Imm:      ?i12   i12!
C  Imm:      ?i12_2  ENCODE
10 Imm:      ?i16   i16!

: cond! ( -- ) \ encode the current condition code
    CCODE @ NARROW? IF 8 ELSE 16 THEN LSHIFT ENCODE ;

: ?noimm ( -- ) \ no immediate value should be set
    IMM @ NOCONST <> IF FAILED THEN ;

: ?noshift ( -- ) \ no shift should be set
    SHIFT @ NOCONST <> IF FAILED THEN ;

\ Register lists
: {  ( -- mark ) \ start a reglist
    77777777 TRUE IN_REGLIST ! ;
: }  ( mark reg1 .. regN -- reglist ) \ finish a reglist
   0 BEGIN OVER 77777777 <> WHILE
     OVER ?REGISTER SWAP BIT OR
   REPEAT  NIP REGLIST !
   FALSE IN_REGLIST ! ;

\ reglist checkers
: ?reglist_lo ( -- ) \ all registers in reglist should be low, it should not be empty
    REGLIST @ NOCONST = ?FAILED!
    REGLIST @ FF > ?FAILED!
    REGLIST @ 0= ?FAILED!
    REGLIST @ i8!
;

: ?reglist_lo&pc ( -- ) \ all registers in reglist should be low, except pc
    REGLIST @ NOCONST = ?FAILED!
    REGLIST @ 80FF INVERT AND ?FAILED!
    REGLIST @ 0= ?FAILED!
    REGLIST @ DUP FF AND i8!
    8000 AND 7 RSHIFT ENCODE
;

: ?reglist_lo&lr ( -- ) \ all registers in reglist should be low, except lr
    REGLIST @ NOCONST = ?FAILED!
    REGLIST @ 40FF INVERT AND ?FAILED!
    REGLIST @ 0= ?FAILED!
    REGLIST @ DUP FF AND i8!
    4000 AND 6 RSHIFT ENCODE
;

: ?reglist ( -- ) \ reglist should not be empty
    REGLIST @ NOCONST = ?FAILED!
    REGLIST @ FFFF > ?FAILED!
    REGLIST @ ENCODE
;

: ?2regs_inlist ( -- ) \ reglist should contain 2 or more registers
    REGLIST @ 1s 2 < ?FAILED!
;

: ?pclr!inlist ( -- ) \ reglist should not contain pc or lr
    REGLIST @ C000 AND C000 = ?FAILED!
;

: ?sp!inlist ( -- ) \ reglist should not contain sp
    REGLIST @ 2000 AND ?FAILED!
;

: ?pc!inlist ( -- ) \ reglist should not contain pc
    REGLIST @ 8000 AND ?FAILED!
;

: ?pc_inlist&last_it ( -- ) \ reglist should not contain pc or be the last in it block
    REGLIST @ 8000 AND 0<>
    last_or_not_in_it_block? INVERT AND ?FAILED!
;

: ?w_Rd_!inlist ( -- ) \ reglist should not contain Rd if writeback is set
    WRITEBACK @
    Rd 1 SWAP LSHIFT REGLIST @ AND
    AND ?FAILED!
;

\ it block checkers
: ?!it ( -- ) \ should not be in it block
    in_it_block? ?FAILED! ;

: ?lastIt ( -- ) \ should not be last in it block
    last_or_not_in_it_block? INVERT ?FAILED! ;

: ?Rd!pc!lastIt ( -- ) \ should not be in it block or Rd should not be pc
    Rd 0F =
    last_or_not_in_it_block? INVERT AND ?FAILED!
;

: ?Rd!sp!lastIt ( -- ) \ should not be in it block or Rd should not be sp
    Rd 0D =
    last_or_not_in_it_block? INVERT AND ?FAILED!
;

\ other checkers
: ?aligned
    THERE TALIGNED? INVERT ABORT" Must be at aligned address"
;

\ set immediate value
: #
    IMM ! ;

\ set bit field width
: #width
    WIDTH ! ;

\ set writeback
: !!
    TRUE WRITEBACK ! ;

\ Special Registers
: PSR:
    CREATE ,
    DOES> @ # ;

 0 PSR: APSR
 1 PSR: IAPSR
 2 PSR: EAPSR
 3 PSR: XPSR
 5 PSR: IPSR
 6 PSR: EPSR
 7 PSR: IEPSR
 8 PSR: MSP
 9 PSR: PSP
10 PSR: PRIMASK
11 PSR: BASEPRI
12 PSR: BASEPRI_MAX
13 PSR: FAULTMASK
14 PSR: CONTROL

: ?spec_reg ( -- ) \ should be a PSR register
    ?imm
    IMM @ DUP ?PSR ENCODE ;

\ addressing modes
: AMODE: \ create an addressing mode modifier
    CREATE BITS ,
    DOES>
        @ ADDRESSING_MODE !
        IMM @ NOCONST = IF 0 IMM ! THEN
;

: [[ POSTPONE [ ; IMMEDIATE \ redefine forth [
: ]] ] ; \ redefine forth ]
: [ ;

\ opcode_bits         mode
0 %P2 %U2      AMODE: +]   \ pre-index
0 %P2          AMODE: -]   \ pre-index
0 %P2 %U2 %W2  AMODE: +]!  \ pre-index + writeback
0 %P2     %W2  AMODE: -]!  \ pre-index + writeback
0     %U2 %W2  AMODE: ]+   \ post-index + writeback
0         %W2  AMODE: ]-   \ post-index + writeback
0     %U2      AMODE: ]    \ post-index

\ create a word for checking addressing mode bits
: MODE2?:
    CREATE ,
    DOES> @ ADDRESSING_MODE @ AND ;

\ addressing mode bit checkers
%P2 MODE2?: P2?
%U2 MODE2?: U2?
%W2 MODE2?: W2?

\ addressing mode checkers
: ?offset ( -- ) \ check and encode addressing mode 2
    ADDRESSING_MODE @ DUP 0= ?1FAILED! ENCODE
    ?i8
;

: mode2>mode1 ( -- mode1 ) \ convert addressing mode 2 to addressing mode 1
    0 P2? IF %P OR THEN
      U2? IF %U OR THEN
      W2? IF %W OR THEN
;

: ?offset2 ( -- ) \ check and encode as addressing mode 1
    ADDRESSING_MODE @ 0= ?FAILED! ( offest_mode )
    mode2>mode1 ENCODE
    ?i8*4
;

: ?P2&W2!0 ( -- ) \ P2 or W2 bits should be set
    P2? 0= W2? 0= AND ?FAILED!
;

: ?W2 ( -- ) \ W2 should not be set
    W2? ?FAILED!
;

: ?P2!1U2!1W2!0 ( -- ) \ P2 or U2 should be 0 or W2 should be 0
    P2? 0<> U2? 0<> AND W2? 0= AND ?FAILED!
;

: ?W2!Rd!Rn ( -- ) \ Rd should not be equal to Rn if W2 is set
    Rd Rn = W2? AND ?FAILED!
;

: ?W2!Rd!Rn!Rm ( -- ) \ Rd should not be equal to Rn or Rm if W2 is set
    Rd Rn = Rd Rm = OR W2? AND ?FAILED!
;

: ?!offset ( -- ) \ addressing mode should be set
    ADDRESSING_MODE @ ?FAILED! ;

\ Modified immediate constants in Thumb instructions
0 VALUE X \ current immediate value to check
: BYTE  ( n -- ) \ take nth byte of X
    X SWAP 8 * RSHIFT FF AND ;

: MSB   ( x -- x n ) \ shift left until MSB is 1, return number of shifts
    0 BEGIN
        OVER 0< INVERT
    WHILE
        1+ SWAP 1 LSHIFT SWAP
    REPEAT
;

\ get parts of an immegiate constant if possible
: #const ( x -- i imm3 abcdefgh T | F )
    DUP IF TO X
        X 0xFFFFFF00 AND 0=                                         IF 0 0  0 BYTE TRUE EXIT THEN
        0 BYTE 2 BYTE =  X 0xFF00FF00 AND 0= AND                    IF 0 1  0 BYTE TRUE EXIT THEN
        1 BYTE 3 BYTE =  X 0x00FF00FF AND 0= AND                    IF 0 2  1 BYTE TRUE EXIT THEN
        0 BYTE 1 BYTE =  2 BYTE 3 BYTE = AND  1 BYTE 2 BYTE = AND   IF 0 3  0 BYTE TRUE EXIT THEN
        X MSB OVER 0x00FFFFFF AND 0= IF
            8 + ( x' i:imm3:a )
            DUP 1 AND 7 LSHIFT ROT 18 RSHIFT 7F AND OR ( i:imm3:a i8 )
            >R 1 RSHIFT DUP 8 AND 3 RSHIFT SWAP 7 AND R> TRUE
        ELSE
            2DROP FALSE
        THEN
    THEN
;

: ?const ( -- ) \ check and encode immediate value as a constant
    IMM @ #const IF
        i8! i3const! i!
    ELSE
        FAILED
    THEN
;

\ register restrictions

: ?RegRestriction!: \ create a restriction for registers not to be equal
    CREATE  ' , ,
    DOES> 2@ EXECUTE = IF FAILED THEN ;

: ?RegRestriction=: \ create a restriction for registers to be equal
    CREATE  ' , ,
    DOES> 2@ EXECUTE <> IF FAILED THEN ;

0D ?RegRestriction!: ?Rd!sp Rd  \ Rd should not be sp
0D ?RegRestriction!: ?Rn!sp Rn  \ Rn should not be sp
0D ?RegRestriction!: ?Rm!sp Rm  \ Rm should not be sp
0D ?RegRestriction!: ?Rt!sp Rt  \ Rt should not be sp
0F ?RegRestriction!: ?Rd!pc Rd  \ Rd should not be pc
0F ?RegRestriction!: ?Rn!pc Rn  \ Rn should not be pc
0F ?RegRestriction!: ?Rm!pc Rm  \ Rm should not be pc
0F ?RegRestriction!: ?Rt!pc Rt  \ Rt should not be pc

0D ?RegRestriction=: ?Rd=sp Rd  \ Rd should be sp
0D ?RegRestriction=: ?Rn=sp Rn  \ Rn should be sp
0D ?RegRestriction=: ?Rm=sp Rm  \ Rn should be sp

\ combined restrictions
: ?Rd!sp!pc     ?Rd!sp ?Rd!pc ;     \ Rd should not be sp or pc
: ?Rn!sp!pc     ?Rn!sp ?Rn!pc ;     \ Rn should not be sp or pc
: ?Rm!sp!pc     ?Rm!sp ?Rm!pc ;     \ Rn should not be sp or pc
: ?all!sp       ?Rd!sp ?Rn!sp ?Rm!sp ?Rt!sp ;       \ all registers should not be sp
: ?all!pc       ?Rd!pc ?Rn!pc ?Rm!pc ?Rt!pc ;       \ all registers should not be pc
: ?all!sp!pc    ?all!sp ?all!pc ;                   \ all registers should not be sp or pc
: ?Rm!Rn        Rm Rn = IF FAILED THEN ;    \ Rm should not equal Rn
: ?Rd!Rn        Rd Rn = IF FAILED THEN ;    \ Rd should not equal Rn
: ?Rd!Rm        Rd Rm = IF FAILED THEN ;    \ Rd should not equal Rm

\ shifts
: ?SHIFT ( x1 -- x1 ) \ check if current shift is possible to encode
    DUP
    SHIFT_TYPE @ CASE
    00 OF 0 20 ENDOF
    01 OF 1 21 ENDOF
    02 OF 1 21 ENDOF
    03 OF 0 20 ENDOF
    ENDCASE
    WITHIN 0= IF FAILED THEN 1F AND ;

: ?SAT_SHIFT ( x1 -- x1 ) ( x1 -- x1 ) \ check if current saturated shift is possible to encode
    DUP
    SHIFT_TYPE @ CASE
    00 OF 0 20  ENDOF
    01 OF -2 -2 ENDOF
    02 OF 1 21  ENDOF
    03 OF -2 -2 ENDOF
    ENDCASE
    WITHIN 0= IF FAILED THEN 1F AND ;

\ create a constant shift
: #SHIFT: ( mask "name" -- )  CREATE ,
  DOES> @  ( shift mask -- )
    SHIFT_TYPE ! SHIFT ! ;

\ create a register controlled shift
: RSHIFT:  ( mask "name" -- )  CREATE ,
   DOES> @  ( n-reg 'register' mask --  operand 'shifted' )
    SHIFT_TYPE ! ;

00 DUP #SHIFT: #lsl  RSHIFT: ,lsl
01 DUP #SHIFT: #lsr  RSHIFT: ,lsr
02 DUP #SHIFT: #asr  RSHIFT: ,asr
03 DUP #SHIFT: #ror  RSHIFT: ,ror

\ rrx is special
: #rrx
    03 SHIFT_TYPE ! 0 SHIFT ! ;
: ,rrx   #rrx ;

\ shift checkers
: ?shift ( -- ) \ check and encode a shift
    SHIFT @ DUP NOCONST = IF DROP 0 THEN ?SHIFT
    DUP 3 AND 6 LSHIFT ENCODE
    1C AND 0A LSHIFT ENCODE
    SHIFT_TYPE @ DUP 0 4 WITHIN IF
        4 LSHIFT ENCODE
    ELSE
        DROP FAILED
    THEN
;

\ wide shift restriction shortcut
: %WIDE_SHIFT
    3 ?regs ?Rd   ?Rn   ?Rm  ?shift     ?all!sp!pc ;

: ?i5shift ( -- ) \ check and encode a 5bit shift
    IMM @ ?SHIFT i5shift!
;

: ?sat_shift ( -- ) \ check and encode a 5bit saturated shift
    ?i5
    SHIFT @ DUP NOCONST = IF DROP 0 THEN
    ?SAT_SHIFT i5shift!
;

: ?lsl2 ( -- ) \ check and encode an lsl shift
    SHIFT_TYPE @ 0 <> ?FAILED!
    SHIFT @ DUP NOCONST = IF DROP 0 THEN i2shift!
;

: ?rot*8 ( -- ) \ check and encode a ror shift
    SHIFT_TYPE @ 03 <> ?FAILED!
    SHIFT @ DUP NOCONST = IF DROP 0 THEN
    DUP 3 AND ?1FAILED!
    3 RSHIFT DUP 2 BIT ?WIDTH IF i2shift! ELSE DROP FAILED THEN
;

\ encode S bit
: %S!
    %S ENCODE ;

\ encode Writeback bit
: %W!
    %W WRITEBACK @ AND ENCODE ;

: TCOMPILE, ( opcode -- ) \ compile an instruction
    DUP 0xB500 = IF 1 ELSE 0 THEN DWARF_LINE \ push {lr} - it is a subprogram prologue
    NARROW? IF TINSTRN, ELSE TINSTRW, THEN
    ITBLOCK @ 1- 0 MAX ITBLOCK ! ;

: ICOMPILE, ( -- ) \ compile current opcode
    INSTRUCTION @ TCOMPILE,
;

\ Branch offsets

: WIDE_OFFSET_LONG   ( offset - mask ) \ create a mask for offset (long value)
    DUP 800000 AND 0= IF \ J1, J2
        600000 XOR
    THEN
    DUP 7FF AND \ i11
    OVER 1FF800 AND 5 LSHIFT OR \ i10
    OVER 200000 AND A RSHIFT OR \ J2
    OVER 400000 AND 9 RSHIFT OR \ J1
    SWAP 800000 AND 3 LSHIFT OR \ S
;

: WIDE_OFFSET   ( offset - mask ) \ create a mask for offset
    DUP 800000 AND 0= IF \ J1, J2
        600000 XOR
    THEN
    DUP 7FF AND \ i11
    OVER 1F800 AND 5 LSHIFT OR \ i6
    OVER 20000 AND 6 RSHIFT OR \ J2
    OVER 40000 AND 5 RSHIFT OR \ J1
    SWAP 80000 AND 7 LSHIFT OR \ S
;

2 80000000
ENUMERATE: FORWARD BACKWARD

: ?OFFSET_ALIGNED ( offset -- )
    1 AND ABORT" Branch destination not 2 byte-aligned" ;

0
CELL -- offest_lo
CELL -- offset_hi
CELL -- offset_instr_length
CELL -- offset_mask
CELL -- offset_bits
DROP

\ create an offset checker that returns a mask
: ?BRANCH-OFFSET: ( low hi length mask -- )
    CREATE 2SWAP SWAP 2, SWAP 2, ' ,
    DOES> ( src dest  -- bits ) >R
        SWAP R@ offset_instr_length @ + - ( offset )
        DUP R@ offest_lo @ R@ offset_hi @ WITHIN 0= ABORT" Branch destination out of range"
        DUP ?OFFSET_ALIGNED
        1 RSHIFT R@ offset_mask @ AND
        R> offset_bits @ EXECUTE
;
\ TODO is len unnessesary?
\      lo       hi len   mask                                           offset_bits
     -100      0FF  4     0FF ?BRANCH-OFFSET:   BRANCH-OFFSET_NARROW    NOOP
     -800      7FF  4    07FF ?BRANCH-OFFSET:   BRANCH-OFFSET_I11       NOOP    \ unconditional
  -100000   0FFFFF  4  0FFFFF ?BRANCH-OFFSET:   BRANCH-OFFSET           WIDE_OFFSET
 -1000000  0FFFFFF  4 0FFFFFF ?BRANCH-OFFSET:   BRANCH-OFFSET_LONG      WIDE_OFFSET_LONG    \ unconditional

\ compile a wide branch to addr
: BWIDE,   ( addr -- )
    WIDE THERE SWAP
    ?al IF ( al condition undefined in wide b<c> )
        BRANCH-OFFSET_LONG  ENCODE
        F0009000
    ELSE    \   conditional
        BRANCH-OFFSET  ENCODE
        cond! F0008000
    THEN ENCODE ICOMPILE, NEW
;

\ compile a narrow branch to addr
: BNARROW,   ( addr -- )
    NARROW THERE SWAP
    ?al IF ( al condition undefined in short b<c> )
        BRANCH-OFFSET_I11  ENCODE
        E000    \ use unconditional branch with i11 offset
    ELSE    \ conditional
        BRANCH-OFFSET_NARROW  ENCODE
        cond! D000
    THEN ENCODE ICOMPILE, NEW
;

: A<MARK  ( -- addr 'backward' ) \ mark a backward reference
    THERE BACKWARD ;
: A<RESOLVE  ( addr 'backward' -- addr ) \ resolve a backward reference
    BACKWARD <> ABORT" Expect assembler backward reference on stack"
    DUP THERE SWAP - ( addr offset )
    ?al IF \ unconditional
        800 < IF \ I11
            BNARROW,
        ELSE    \ long
            BWIDE,
        THEN
    ELSE
        100 < IF    \ narrow
            BNARROW,
        ELSE        \ wide
            BWIDE,
        THEN
    THEN
;
: A>MARK  ( -- ADDR 'FORWARD' ADDR ) \ mark a forward reference
    THERE FORWARD   OVER  ;

: A>RESOLVE_NARROW  ( addr 'forward' -- ) \ resolve a narrow forward reference
   FORWARD <> ABORT" Expect assembler forward reference on stack"
   DUP  TW@ F000 AND D000 = IF \ i8 conditional?
        DUP  THERE BRANCH-OFFSET_NARROW ( addr bits )
        OVER TW@ FF00
   ELSE \ i11 unconditional
        DUP  THERE BRANCH-OFFSET_I11 ( addr bits )
        OVER TW@ F800
   THEN
   AND  OR   SWAP TW! \ erase old jmp addr and encode the new one
;

: A>RESOLVE_WIDE  ( addr 'forward' -- ) \ resolve a wide forward reference
   FORWARD <> ABORT" Expect assembler forward reference on stack"
   DUP  INSTR@ F8001000 AND F0000000 = IF \ conditional?
        DUP  THERE BRANCH-OFFSET ( addr bits )
        OVER INSTR@ FBC0D000
   ELSE \ unconditional
        DUP  THERE BRANCH-OFFSET_LONG ( addr bits )
        OVER INSTR@ F800D000
   THEN
   AND   OR   SWAP INSTR! \ erase old jmp addr and encode the new one
;

\ Labels and conditionals

: ?condition
    ?al ABORT" Condition needed!" ;

: invert ( -- ) \ invert current conditional code
    ?al INVERT IF CCODE @ 1 XOR CCODE ! THEN ;

: label     THERE CONSTANT ; \ create a label

\ if operators
: if-not    ?condition A>MARK BNARROW, ;
: if-not.w  ?condition A>MARK BWIDE, ;
: if        invert if-not ;
: if.w      invert if-not.w ;
: ahead     al if-not ; \ unconditional forward branch
: ahead.w   al if-not.w ;

\ then operators
: then      A>RESOLVE_NARROW ;
: ?then     DUP FORWARD = IF A>RESOLVE_NARROW THEN ; \ compile then if there was a forward mark
: then.w    A>RESOLVE_WIDE ;

\ else operators
: else      A>MARK al BNARROW,  2SWAP then ;
: else.w    A>MARK al BWIDE,  2SWAP then.w ;

\ loops
: begin     A<MARK ;
: until-not A<RESOLVE ;
: until     invert A<RESOLVE ;
: again     al until-not ;
: while-not if-not ;
: while-not.w  if-not.w ;
: while     invert if-not ;
: while.w   invert if-not.w ;
: repeat    2SWAP  again  then ;
: repeat.w  2SWAP  again  then.w ;
: repeat-until-not  2SWAP  until-not  then ;

\ instruction assembling

: DROP-1 ( -1 n1 n2 ... nm -- ) \ drop all values until -1
    BEGIN  -1 = UNTIL ;

\ end a variant description
: VARIANT; ( -1 mask1 ... maskn -- 0 mask1 ... maskn-1 | -- )
    FAILED? IF
        DROP \ if any of the checkers and restrictions failed, drop the opcode and continue
    ELSE
        \ found the suitable variant, compile and exit normally
        NEW
        ENCODE ICOMPILE,
        DROP-1
        RDROP \ exit
    THEN
;

: E_UNPREDICTABLE
    TRUE ABORT" UNPREDICTABLE!"
;

\ define instruction variants
\ it will leave xt on the stack
: VARIANTS{
    :NONAME
;

\ end variants definition
\ if the flow reached here, none of the variants fits, and it will be an error
: }VARIANTS
    POSTPONE E_UNPREDICTABLE POSTPONE ;
; IMMEDIATE

\ start opcode list
\ just place a marker onto the stack
: OP{
    -1 ;

: OP'{
    OP{ ' SWAP ;

\ compile opcodes into dictionary until the marker
\ compile the marker as well
: COMPILE_OPCODES ( -1 mask1 ... maskn -- )
    BEGIN DUP , -1 = UNTIL ;

\ extract compiled opcodes from address a onto the stack
\ leave the end address on the stack
: EXTRACT_OPCODES ( a -- -1 mask1 ... maskn a' )
    -1 SWAP
    BEGIN ( -1 maskn .. maskx addr )
        DUP @ -1 <>
    WHILE
        DUP @ SWAP CELL+
    REPEAT
;

\ finish opcode list and create an assembly mnemonic
\ xt is the variants list definition
: }OP
    CREATE  ( xt -1 mask1 ... maskn "name" -- )
        COMPILE_OPCODES
        ,
    DOES>   ( -- )
        EXTRACT_OPCODES
        CELL+ @ EXECUTE \ execute variants list definition xt on extracted opcodes
;

\ same as above, but apply xt' afterwards
: }'OP
    CREATE  ( xt' xt -1 mask1 ... maskn "name" -- )
        COMPILE_OPCODES
        2,
    DOES>   ( -- )
        EXTRACT_OPCODES
        CELL+ 2@ EXECUTE EXECUTE
;

\ create a wide assembly mnemonic without parameters
: WIDE_OP:
    CREATE ,
    DOES> WIDE @ TCOMPILE, NEW
;

\ create a narrow assembly mnemonic without parameters
: NARROW_OP:
    CREATE ,
    DOES> NARROW @ TCOMPILE, NEW
;

\ it blocks

0 VALUE itmask \ current mask

\ create itxxxx mnemonic
: IT_OP:
    CREATE 2,
    DOES>
        ?in_it_block
        ?condition 2@ TO itmask ( count )
        DUP 0 ?DO
            CCODE @ 1 AND           \ get firstcond[0]
            itmask I LSHIFT 8 AND   \ get current bit in mask
            0= IF 1 XOR THEN        \ invert firstcond[0] if bit in mask is 1
            3 I - LSHIFT            \ shift to position
            1 3 I - LSHIFT INVERT   \ get mask to clear current bit in mask
            itmask AND              \ clear bit
            OR TO itmask            \ combine with new bit
        LOOP
        itmask CCODE @ 4 LSHIFT OR 0BF00 OR NARROW TCOMPILE, NEW
        1+ ITBLOCK !
;

\ ========================================== mnemonics ================================================

\ define variant list for this mnemonic type
\ first variant should be the optimal one if multiple are possible
\          Rd Rn Rm Rt const, shift etc    restrictions
VARIANTS{
    \ narrow opcode, needs 2 registers to be used, Rd and Rn should be low, no immediate values allowed
    NARROW 2 ?regs ?RdLo ?RnLo ?noimm                                              VARIANT;
    \ wide opcode, 2 registers (Rd and Rn), immediate constant, all registers should not be pc or sp, set %S bit
    WIDE   2 ?regs ?Rd   ?Rn   ?const      ?all!sp!pc                          %S! VARIANT;
    \ wide shift opcode, see the shortcut definition
    WIDE   %WIDE_SHIFT                                                         %S! VARIANT;
}VARIANTS ( xt )

\ create a mnemonic
\ number of masks between OP{ and }OP should match number of variants in variants list
\ first mask is for first variant etc...

DUP OP{ 0x4140 0xF1400000 0xEB400000 }OP adcs
DUP OP{ 0x4000 0xF0000000 0xEA000000 }OP ands
DUP OP{ 0x4380 0xF0200000 0xEA200000 }OP bics
DUP OP{ 0x4040 0xF0800000 0xEA800000 }OP eors
DUP OP{ 0x4300 0xF0400000 0xEA400000 }OP orrs
DUP OP{ 0x4240 0xF1C00000 0xEBC00000 }OP rsbs
    OP{ 0x4180 0xF1600000 0xEB600000 }OP sbcs

VARIANTS{
    WIDE   2 ?regs ?Rd   ?Rn   ?const      ?all!sp!pc                              VARIANT;
    WIDE   %WIDE_SHIFT                                                             VARIANT;
}VARIANTS ( xt )

DUP OP{ 0xF1400000 0xEB400000 }OP adc
DUP OP{ 0xF0000000 0xEA000000 }OP and
DUP OP{ 0xF0200000 0xEA200000 }OP bic
DUP OP{ 0xF0800000 0xEA800000 }OP eor
DUP OP{ 0xF0600000 0xEA600000 }OP orn
DUP OP{ 0xF0400000 0xEA400000 }OP orr
DUP OP{ 0xF1C00000 0xEBC00000 }OP rsb
    OP{ 0xF1600000 0xEB600000 }OP sbc

VARIANTS{
    NARROW 2 ?regs ?RdLo ?RnLo ?i3                                                 VARIANT;
    NARROW 1 ?regs ?RdLo8 ?i8                                                      VARIANT;
    NARROW 3 ?regs ?RdLo ?RnLo ?RmLo ?noimm                                        VARIANT;
    WIDE   2 ?regs ?Rd   ?Rn   ?const      ?Rd!sp!pc ?Rn!pc                    %S! VARIANT;
    WIDE   %WIDE_SHIFT                                                         %S! VARIANT;
}VARIANTS

DUP OP{ 0x1C00 0x3000 0x1800 0xF1000000 0xEB000000 }OP adds
    OP{ 0x1E00 0x3800 0x1A00 0xF1A00000 0xEBA00000 }OP subs

VARIANTS{
    NARROW 2 ?regs ?Rd=sp ?Rn=sp ?i7*4                                             VARIANT;
    NARROW 2 ?regs ?RdLo8 ?Rn=sp ?i8*4                                              VARIANT;
    NARROW 2 ?regs ?Rd>Rd2  ?Rn>Rn2 ?noimm     ?Rd!sp!lastIt ?Rd!sp ?Rm!sp         VARIANT;
    WIDE   2 ?regs ?Rd   ?Rn   ?const          ?all!pc ?Rd!sp                      VARIANT;
    WIDE   %WIDE_SHIFT                                                             VARIANT;
}VARIANTS ( xt )

    OP{ 0xB000 0xA800 0x4400 0xF1000000 0xEB000000 }OP add

VARIANTS{
    WIDE   2 ?regs ?Rd   ?Rn   ?i12            ?Rd!sp!pc                           VARIANT;
}VARIANTS ( xt )

DUP OP{ 0xF2000000 }OP addw
    OP{ 0xF2A00000 }OP subw

VARIANTS{
    NARROW 1 ?regs ?RdLo8 ?+label8*4                                               VARIANT;
    WIDE   1 ?regs ?Rd   ?-label12              ?Rd!sp!pc                          VARIANT;
    WIDE   1 ?regs ?Rd   ?+label12              ?Rd!sp!pc                          VARIANT;
}VARIANTS ( xt )

    OP{ 0xA000 0xF2AF0000 0xF20F0000 }OP adr

VARIANTS{
    NARROW 2 ?regs ?RdLo ?RnLo ?i5shift                                            VARIANT;
    NARROW 2 ?regs ?RdLo ?RnLo ?noimm                                              VARIANT;
    WIDE   2 ?regs ?Rd   ?Rn>Rm ?i5shift         ?all!sp!pc                    %S! VARIANT;
    WIDE   3 ?regs ?Rd   ?Rn   ?Rm               ?all!sp!pc                    %S! VARIANT;
}VARIANTS ( xt )

DUP OP'{ ,asr 0x1000 0x4100 0xEA4F0020 0xFA40F000 }'OP asrs
DUP OP'{ ,lsl 0x0000 0x4080 0xEA4F0000 0xFA00F000 }'OP lsls
    OP'{ ,lsr 0x0800 0x40C0 0xEA4F0010 0xFA20F000 }'OP lsrs

VARIANTS{
    WIDE   2 ?regs ?Rd   ?Rn>Rm ?i5shift         ?all!sp!pc                        VARIANT;
    WIDE   3 ?regs ?Rd   ?Rn   ?Rm               ?all!sp!pc                        VARIANT;
}VARIANTS ( xt )

DUP OP'{ ,asr 0xEA4F0020 0xFA40F000 }'OP asr
DUP OP'{ ,lsl 0xEA4F0000 0xFA00F000 }'OP lsl
DUP OP'{ ,lsr 0xEA4F0010 0xFA20F000 }'OP lsr
    OP'{ ,ror 0xEA4F0030 0xFA60F000 }'OP ror

VARIANTS{
    WIDE   1 ?regs ?Rd   ?i5shift   ?width        ?all!sp!pc                       VARIANT;
}VARIANTS ( xt )

    OP{ 0xF36F0000 }OP bfc

VARIANTS{
    WIDE   2 ?regs ?Rd   ?Rn    ?i5shift ?width   ?Rd!sp!pc                        VARIANT;
}VARIANTS ( xt )

