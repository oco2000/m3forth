VARIANTS{
    NARROW   2 ?regs ?RdLo ?RnLo  ?noshift ?i5*2       ?W2                                             VARIANT; \ immediate T1
    WIDE     2 ?regs ?Rd>Rt   ?Rn ?noshift ?offset     ?P2&W2!0 ?P2!1U2!1W2!0 ?Rd!sp!pc ?W2!Rd!Rn      VARIANT; \ immediate T3
