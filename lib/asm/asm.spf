}VARIANTS ( xt )

DUP OP{ 0xBE00 }OP bkpt
    OP{ 0xDF00 }OP svc

\ branch and link
: bl   ( -- )
    WIDE
    IMM @ DUP NOCONST = ABORT" Label needed!"
    THERE SWAP BRANCH-OFFSET_LONG ENCODE
    F000D000 ENCODE
    ICOMPILE, NEW
;

VARIANTS{
