\ count  mask
    0       8   IT_OP: it
    1       C   IT_OP: itt
    1       4   IT_OP: ite
    2       E   IT_OP: ittt
    2       6   IT_OP: itet
    2       A   IT_OP: itte
    2       2   IT_OP: itee
    3       F   IT_OP: itttt
    3       7   IT_OP: itett
    3       B   IT_OP: ittet
    3       3   IT_OP: iteet
    3       D   IT_OP: ittte
    3       5   IT_OP: itete
    3       9   IT_OP: ittee
    3       1   IT_OP: iteee

F3BF8F2F WIDE_OP: clrex
F3AF8000 WIDE_OP: nop.w
F3AF8001 WIDE_OP: yield.w
F3AF8002 WIDE_OP: wfe.w
F3AF8003 WIDE_OP: wfi.w
F3AF8004 WIDE_OP: sev.w

BF00 NARROW_OP: nop
BF10 NARROW_OP: yield
BF20 NARROW_OP: wfe
BF30 NARROW_OP: wfi
BF40 NARROW_OP: sev

\ =================================== end mnemonics =======================================================

PREVIOUS DEFINITIONS

\ start inline assembly
: ASM{   ALSO ASSEMBLER [ ALSO ASSEMBLER ]] NEW [[ PREVIOUS ]  ;

\ finish inline assembly
: }ASM   PREVIOUS ;

\ same, immediate
: [ASM]   ASM{ ; IMMEDIATE
: [END-ASM]   }ASM ; IMMEDIATE

: ?CONST ( x - f ) \ can x be expressed by thumb2 constant?
    [ ALSO ASSEMBLER ]]  #const  [[ PREVIOUS ]
    DUP IF 2DROP 2DROP TRUE THEN
;

BASE !

\EOF
